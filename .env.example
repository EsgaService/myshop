# Copy to .env.local and fill in. Never commit real values.

# Supabase project ihbmaydqjsoynsiugzfv
NEXT_PUBLIC_SUPABASE_URL=https://ihbmaydqjsoynsiugzfv.supabase.co
# Publishable (or legacy anon) key. Safe for the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret / service role key. SERVER ONLY: never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# "mock" accepts any payment (development only). Anything else disables checkout.
PAYMENTS_MODE=mock

# Public origin of the site (used for OAuth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
