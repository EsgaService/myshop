# Copy to .env.local and fill in. Never commit real values.

# Supabase project ihbmaydqjsoynsiugzfv
NEXT_PUBLIC_SUPABASE_URL=https://ihbmaydqjsoynsiugzfv.supabase.co
# Publishable (or legacy anon) key. Safe for the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret / service role key. SERVER ONLY: never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# "mock" accepts any payment (development only). Anything else disables checkout.
PAYMENTS_MODE=mock

# Public origin of the site (used for OAuth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:4000

# AI ingestion (seller PDF -> interactive recipe book)
# "mock" returns a deterministic fixture; "anthropic" calls Claude. Empty: anthropic if ANTHROPIC_API_KEY is set, else mock.
AI_PROVIDER=
# SERVER ONLY.
ANTHROPIC_API_KEY=
# Default: claude-sonnet-5-5
ANTHROPIC_MODEL=

# Bearer secret for POST /api/ingestion/run (cron / external worker trigger). Endpoint fails closed when empty.
INGESTION_WORKER_SECRET=
